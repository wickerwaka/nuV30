             cs_r      = flush_cs;
             fetch_ptr = flush_ip;
             suspended = 1'b0;
@@ -2139,7 +2209,7 @@ always_comb begin
             // is SAMPLED at a fixed cycle index (2 = T3) and LATCHED; the
