+        $fatal(1, "v30u_biu: WAVE 15 C1 IDENTITY VIOLATED at %0t -- composed=%b reference=%b  (pop_eff=%b q_cnt=%0d q_cnt_np=%0d grn_n=%0d grn_ttl=%0d)",
